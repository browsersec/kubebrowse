{
  "info": {
    "name": "KubeBrowse API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Office Session",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/sessions/office",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "sessions", "office"]
        }
      }
    },
    {
      "name": "Get WebSocket Connection Info",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/sessions/:connection_id/connect",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "sessions", ":connection_id", "connect"]
        }
      }
    },
    {
      "name": "Stop Session and Delete Pod",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/sessions/:connection_id/stop",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", ":connection_id", "stop"]
        }
      }
    },
    {
      "name": "List Active Sessions",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/sessions/",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", ""]
        }
      }
    },
    {
      "name": "Create Browser Pod",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pods/browser",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pods", "browser"]
        }
      }
    },
    {
      "name": "Create Office Pod (alternate)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pods/office",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pods", "office"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    }
  ]
}
